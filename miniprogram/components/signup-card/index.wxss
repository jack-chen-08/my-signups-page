.signup-card {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
  overflow: hidden;
}

.card-main {
  display: flex;
  align-items: flex-start;
}

/* 封面缩略图：mock 数据用渐变占位，接入后替换 cover_url */
.cover {
  position: relative;
  flex: none;
  width: 168rpx;
  height: 168rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.cover-char {
  font-size: 56rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 2rpx;
}

.info {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
  color: rgba(0, 0, 0, 0.9);
  margin-right: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 34rpx;
}

.meta-label {
  flex: none;
  width: 56rpx;
  color: rgba(0, 0, 0, 0.3);
}

.meta-value {
  flex: 1;
  min-width: 0;
  color: rgba(0, 0, 0, 0.6);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deadline {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #fff1e9;
  color: #e37318;
  font-size: 20rpx;
  line-height: 28rpx;
}

/* 审核说明展开区 */
.review {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1px solid #f0f0f0;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-title {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.6);
}

.review-toggle {
  font-size: 24rpx;
  color: #0052d9;
}

.review-body {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
  font-size: 24rpx;
  line-height: 36rpx;
  color: rgba(0, 0, 0, 0.6);
}

/* 操作区 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1px solid #f0f0f0;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 24rpx;
  margin-left: 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  border: 1px solid #dcdcdc;
  color: rgba(0, 0, 0, 0.9);
  background: #ffffff;
}

.btn-primary {
  border-color: #0052d9;
  background: #0052d9;
  color: #ffffff;
}

.btn-ghost {
  border-color: #dcdcdc;
  background: #ffffff;
  color: rgba(0, 0, 0, 0.9);
}

/* 已提交问卷：不可再点，弱化展示 */
.btn-done {
  border-color: #e7e7e7;
  background: #f7f7f7;
  color: rgba(0, 0, 0, 0.3);
}

.btn--hover {
  opacity: 0.75;
}

.review-head--hover {
  opacity: 0.6;
}
