.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #f3f3f3;
}

/* 顶部 Tab 吸顶 */
.tabs-wrap {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #ffffff;
  border-bottom: 1px solid #e7e7e7;
}

/* 「待填问卷」角标由 t-tab-panel 的 badge-props 渲染（TDesign Badge），此处无需额外样式 */

/* 骨架屏 */
.skeleton {
  padding-top: 24rpx;
}

.skeleton-card {
  display: flex;
  align-items: flex-start;
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.skeleton-cover {
  width: 168rpx;
  height: 168rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: #f0f0f0;
}

.skeleton-lines {
  flex: 1;
  padding-top: 8rpx;
}

.skeleton-line {
  height: 24rpx;
  margin-bottom: 18rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.skeleton-line.w70 {
  width: 70%;
}

.skeleton-line.w90 {
  width: 90%;
}

.skeleton-line.w50 {
  width: 50%;
}

/* 加载失败 */
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 48rpx;
  gap: 28rpx;
}

.error-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.6);
}

/* 列表尾部提示 */
.list-tip {
  padding: 32rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.3);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx 40rpx;
}

.empty-art {
  width: 200rpx;
  height: 200rpx;
  border-radius: 100rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

/* CSS 画的票券占位图，避免依赖图片资源 */
.empty-ticket {
  width: 100rpx;
  height: 72rpx;
  border: 4rpx solid #d9d9d9;
  border-radius: 12rpx;
  padding: 16rpx 12rpx;
}

.empty-ticket__line {
  height: 8rpx;
  border-radius: 4rpx;
  background: #e3e3e3;
  margin-bottom: 10rpx;
}

.empty-ticket__line.short {
  width: 60%;
  margin-bottom: 0;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.3);
  text-align: center;
}

.empty-btn {
  margin-top: 40rpx;
  height: 72rpx;
  padding: 0 48rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #0052d9;
  color: #ffffff;
}

/* 通用按钮（页面级错误重试 / 空状态按钮） */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}

.btn-primary {
  background: #0052d9;
  color: #ffffff;
}
